{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start ML Service",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe ml_service/main.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Node Backend",
      "type": "shell",
      "command": "node server.js",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Scraper",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe ml_service/scraper.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start React Frontend",
      "type": "shell",
      "command": "npm --prefix frontend dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
